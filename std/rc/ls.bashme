# shellcheck shell=bash
# shellcheck disable=SC2012,SC2139,SC2329

LS_PATH=$(which ls)
LSD_PATH=$(which lsd 2> /dev/null) || unset LSD_PATH

function define_default_ls {
    builtin alias ls="$LS_PATH"\ --color=auto

    function lsr {
        ls -FR --color=always "$@" | less
    }

    readonly -f lsr
    builtin alias llr='lsr -lh'
}

function define_deluxe_ls {
    # TODO: Make customizable
    export LSD_DATE_FORMAT='%d.%m.%Y %H:%M.%S'

    function lsd {
        if [[ -n $LSD_DATE_FORMAT ]]; then
            "$LSD_PATH" --date "+$LSD_DATE_FORMAT" "$@"
        else
            "$LSD_PATH" "$@"
        fi
    }

    function ls {
        local arg has_options

        for arg in "$@"; do
            if [[ $arg == -* ]]; then
                has_options=
                break
            fi
        done

        if [[ -v has_options ]]; then
            "$LS_PATH" --color=auto "$@"
        else
            lsd "$@"
        fi
    }

    function lsr {
        if [[ -t 1 ]]; then
            lsd --tree -F --color always --icon always "$@" | less
        else
            lsd --tree -F "$@"
        fi
    }

    readonly -f ls lsd lsr
    builtin alias llr='lsr -l'
}

function define_strict_ls_aliases {
    builtin alias ls-ctime='ls -lFhcr' # sort by change time
    builtin alias ls-atime='ls -lFhur' # sort by access time
}

function define_generic_ls_aliases {
    builtin alias ll="$LS_NAME"\ -lAFh
    builtin alias l.="$LS_NAME"' -d .*' # short listing, only hidden files - .*
    builtin alias la="$LS_NAME"\ -al    # show hidden files

    builtin alias ls-size="$LS_NAME"\ -lFhS   # sort by size smallest to largest
    builtin alias ls-mtime="$LS_NAME"\ -lFhtr # sort by modify time
}

bashme_hold --interactive
bashme_print -f define_strict_ls_aliases -s LS_PATH

if [[ -v LSD_PATH ]]; then
    bashme_print -f define_deluxe_ls -s LS_PATH -s LSD_PATH
    LS_NAME='lsd'
else
    bashme_print -f define_default_ls -s LS_PATH
    LS_NAME='ls'
fi

bashme_print -f define_generic_ls_aliases -s LS_NAME
