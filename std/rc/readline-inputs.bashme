# shellcheck shell=bash

[[ ! -f "$HOME/.inputrc" ]] || return 0

function set_readline_defaults {
    # Perform file completion in a case insensitive fashion
    builtin bind 'set completion-ignore-case on'

    # Immediately add a trailing slash when autocompleting symlinks to directories
    builtin bind 'set mark-symlinked-directories on'

    # Enable history expansion with space
    # E.g. typing !!<space> will replace the !! with your last command
    builtin bind Space:magic-space

    # Display matches for ambiguous patterns at first tab press
    builtin bind 'set show-all-if-ambiguous on'

    # Enable incremental history search with up/down arrows (also Readline goodness)
    # Learn more about this here: http://codeinthehole.com/writing/the-most-important-command-line-tip-incremental-history-searching-with-inputrc/
    builtin bind '"\e[A": history-search-backward'
    builtin bind '"\e[B": history-search-forward'
    builtin bind '"\e[C": forward-char'
    builtin bind '"\e[D": backward-char'
}

bashme_hold --interactive
bashme_print -f set_readline_defaults
