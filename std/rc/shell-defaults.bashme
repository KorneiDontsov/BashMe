# shellcheck shell=bash
# shellcheck disable=SC2178

function set_general_defaults {
    # * noclobber
    # Prevent file overwrite on stdout redirection
    # Use `>|` to force redirection to an existing file
    builtin set -o noclobber

    # * histappend
    # Append to the history file, don't overwrite it
    # * cmdhist
    # Save multi-line commands as one command
    builtin shopt -s histappend cmdhist

    # Avoid duplicate entries
    HISTCONTROL=erasedups:ignoreboth

    # Don't record some commands
    HISTIGNORE='&:[ ]*:exit:ls:la:ll:l:l1:bg:fg:history:clear'

    # Use standard ISO 8601 timestamp
    # %F equivalent to %Y-%m-%d
    # %T equivalent to %H:%M:%S (24-hours format)
    HISTTIMEFORMAT='%F %T '
}

function set_interactive_defaults {

    # * cdable_vars
    # This allows you to bookmark your favorite places across the file system
    # Define a variable containing a path and you will be able to cd into it
    # regardless of the directory you're in
    # * globstar
    # Turn on recursive globbing (enables ** to recurse all directories)
    # * checkwinsize
    # Update window size after every command
    # * autocd
    # Prepend cd to directory names automatically
    # * dirspell
    # Correct spelling errors during tab-completion
    # * cdspell
    # Correct spelling errors in arguments supplied to cd
    builtin shopt -s cdable_vars globstar checkwinsize autocd dirspell cdspell

    # Automatically trim long paths in the prompt
    PROMPT_DIRTRIM=2
}

# Record each line as it gets issued
if ((BASH_VERSINFO[0] > 5 || BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] >= 1)); then
    function record_history_on_fly {
        PROMPT_COMMAND=("builtin history -a" "${PROMPT_COMMAND[@]}")
    }
else
    function record_history_on_fly {
        PROMPT_COMMAND="builtin history -a; ${PROMPT_COMMAND:-}"
    }
fi

bashme_print -f set_general_defaults
bashme_hold --interactive
bashme_print -f set_interactive_defaults
bashme_print -f record_history_on_fly
